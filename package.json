{
  "name": "bilibili-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "B站用户活跃度与内容消费分析 Dashboard —— 求职作品集项目",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:export": "node scripts/export-data.mjs",
    "data:analyze": "python scripts/analyze.py",
    "data:refresh": "npm run data:export && npm run data:analyze"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
